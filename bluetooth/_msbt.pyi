from collections.abc import Buffer
from typing import SupportsIndex, TypedDict, overload

AF_BTH: int
SOCK_STREAM: int
BTHPROTO_RFCOMM: int
BT_PORT_ANY: int
SOL_RFCOMM: int
SO_BTH_AUTHENTICATE: int
SO_BTH_ENCRYPT: int
SO_BTH_MTU: int
SO_BTH_MTU_MAX: int
SO_BTH_MTU_MIN: int

class ServiceRecord(TypedDict):
    host: str
    name: str | None
    description: str | None
    port: int | None
    protocol: str
    rawrecord: bytes

def initwinsock() -> None: ...
def socket(type: int, protocol: int, /) -> int: ...
def bind(descriptor: SupportsIndex, address: str | None, port: int, /) -> None: ...
def listen(descriptor: SupportsIndex, backlog: int, /) -> None: ...
def accept(descriptor: SupportsIndex, /) -> tuple[int, str, int]: ...
def connect(descriptor: SupportsIndex, address: str, port: int, /) -> None: ...
def send(descriptor: SupportsIndex, data: Buffer | str, flags: int = 0, /) -> int: ...
def recv(descriptor: SupportsIndex, size: int, flags: int = 0, /) -> bytes: ...
def close(descriptor: SupportsIndex, /) -> None: ...
def getsockname(descriptor: SupportsIndex, /) -> tuple[str, int]: ...
def getpeername(descriptor: SupportsIndex, /) -> tuple[str, int]: ...
def dup(descriptor: SupportsIndex, /) -> int: ...
def discover_devices(duration: int = 8, flush_cache: bool = True) -> list[tuple[str, str, int]]: ...
def list_local() -> list[str]: ...
def lookup_name(address: str, /) -> str: ...
def find_service(address: str, uuid: str, /) -> list[ServiceRecord]: ...
def set_service(descriptor: SupportsIndex, advertise: int, name: str, description: str, uuid: str, /) -> None: ...
def set_service_raw(record: Buffer | str, advertise: int, handle: int | None = None, /) -> int: ...
def setblocking(descriptor: SupportsIndex, blocking: int, /) -> None: ...
def settimeout(descriptor: SupportsIndex, seconds: float, /) -> None: ...
def gettimeout(descriptor: SupportsIndex, /) -> float: ...
def setsockopt(descriptor: SupportsIndex, level: int, option: int, value: SupportsIndex | Buffer, /) -> None: ...
@overload
def getsockopt(descriptor: SupportsIndex, level: int, option: int, /) -> int: ...
@overload
def getsockopt(descriptor: SupportsIndex, level: int, option: int, size: int, /) -> int | bytes: ...
